@page "/gateways/{Id:guid}"
@rendermode InteractiveServer

@using OcelotAdmin.Domain
@using OcelotAdmin.Domain.Ocelot
@using OcelotAdmin.Features.Gateways
@using OcelotAdmin.Features.Ocelot

@inject GatewayService GatewayService
@inject OcelotConfigurationService OcelotConfigurationService
<PageTitle>Gateway</PageTitle>

@if (gateway is null)
{
    <p>Gateway not found.</p>
}
else
{
    <h1>@gateway.Name</h1>

    <dl>
        <dt>Configuration Store</dt>
        <dd>@gateway.ConfigStoreType</dd>

        @if (gateway.FileSettings is not null)
        {
            <dt>Configuration Path</dt>
            <dd>@gateway.FileSettings.ConfigurationPath</dd>
        }

        @if (gateway.ConsulSettings is not null)
        {
            <dt>Consul Address</dt>
            <dd>@gateway.ConsulSettings.Address</dd>

            <dt>Configuration Key</dt>
            <dd>@gateway.ConsulSettings.ConfigurationKey</dd>
        }
    </dl>

    <button
        class="btn btn-primary"
        @onclick="LoadConfigurationAsync"
        disabled="@isLoading">
        Load Live Configuration
    </button>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger mt-3">
            @error
        </div>
    }

    @if (configuration is not null)
    {
        <h3 class="mt-4">
            Routes (@configuration.Routes.Count)
        </h3>

        <table class="table">
            <thead>
            <tr>
                <th>Methods</th>
                <th>Upstream</th>
                <th>Service</th>
                <th>Downstream</th>
                <th>Load Balancer</th>
            </tr>
            </thead>

            <tbody>
            @for (var i = 0; i < configuration.Routes.Count; i++)
            {
                var route = configuration.Routes[i];
                <tr>
                    <td>
                        @string.Join(", ", route.UpstreamHttpMethod)
                    </td>

                    <td>
                        @route.UpstreamPathTemplate
                    </td>

                    <td>
                        @route.ServiceName
                    </td>

                    <td>
                        @route.DownstreamPathTemplate
                    </td>

                    <td>
                        @route.LoadBalancerOptions?.Type
                    </td>
                    <td>
                        <a href="/gateways/@Id/routes/@i">
                            Edit
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Gateway? gateway;
    private OcelotConfiguration? configuration;
    private string? error;
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        gateway = await GatewayService.GetByIdAsync(Id);
    }

    private async Task LoadConfigurationAsync()
    {
        try
        {
            isLoading = true;
            error = null;
            configuration = null;

            var result =
                await OcelotConfigurationService.GetLiveAsync(Id);

            if (!result.IsSuccess)
            {
                error = result.Error;
                return;
            }

            configuration = result.Value;
        }
        finally
        {
            isLoading = false;
        }
    }
}